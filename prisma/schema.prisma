generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Usuarios & Roles ───────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("vendedor") // admin, vendedor, laboratorio, medico
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medico            Medico?
  solicitudesCreadas Solicitud[]     @relation("SolicitudCreator")
  validaciones       Solicitud[]     @relation("SolicitudValidator")
  despachos          Fulfillment[]   @relation("FulfillmentResponsable")
  evidencias         EvidenciaEntrega[] @relation("EvidenciaCreator")
  activityLogs       ActivityLog[]
}

// ─── Médicos / Clientes ─────────────────────────────────────────

model Medico {
  id                String   @id @default(cuid())
  userId            String?  @unique
  nombre            String
  dni               String   @unique
  matriculaNacional String?
  matriculaProvincial String?
  especialidad      String?
  subespecialidad   String?
  institucion       String?
  cargo             String?
  telefono          String?
  whatsapp          String?
  email             String   @unique
  direccion         String?
  ciudad            String?
  provincia         String?
  codigoPostal      String?
  miembroSAMHRE     Boolean  @default(false)
  numMiembroSAMHRE  String?
  certificadoISSCA  Boolean  @default(false)
  numCertificadoISSCA String?
  workshopCellgenic Boolean  @default(false)
  fechaWorkshop     DateTime?
  otraFormacion     String?
  estado            String   @default("pendiente") // pendiente, validado, rechazado
  documentos        MedicoDocumento[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user        User?        @relation(fields: [userId], references: [id])
  pacientes   Paciente[]
  solicitudes Solicitud[]
}

model MedicoDocumento {
  id        String   @id @default(cuid())
  medicoId  String
  tipo      String   // matricula, dni, certificado_issca, membresia_samhre, otro
  nombre    String
  fileUrl   String
  createdAt DateTime @default(now())

  medico Medico @relation(fields: [medicoId], references: [id], onDelete: Cascade)
}

// ─── Pacientes ──────────────────────────────────────────────────

model Paciente {
  id                String    @id @default(cuid())
  nombre            String
  dni               String
  fechaNacimiento   DateTime?
  edad              Int?
  sexo              String?   // masculino, femenino
  peso              String?
  altura            String?
  telefono          String?
  email             String?
  medicoId          String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  medico      Medico      @relation(fields: [medicoId], references: [id])
  solicitudes Solicitud[]
}

// ─── Solicitudes (Órdenes) ──────────────────────────────────────

model Solicitud {
  id                  String   @id @default(cuid())
  numero              String   @unique
  medicoId            String
  pacienteId          String
  estado              String   @default("pendiente")
  // pendiente → validacion_documental → aprobado → en_preparacion → despachado → entregado → cerrado | rechazado

  // Información clínica
  diagnosticoPrincipal  String?
  diagnosticoSecundario String?
  tiempoEvolucion       String?
  tratamientosPrevios   String?
  objetivoTerapeutico   String?  // regeneracion_articular, dolor_cronico, etc.

  // Producto solicitado
  categoriaProducto     String?  // exosomas, celulas_madre, fibroblastos, peptidos, etc.
  nombreProducto        String?
  presentacion          String?
  cantidadSolicitada    Int?
  numeroViales          Int?
  dosisRequerida        String?
  concentracion         String?

  // Administración
  viaAdministracion     String?  // intravenosa, intraarticular, intradermica, etc.
  cantidadAplicar       String?
  numSesiones           Int?
  fechaAplicacion       DateTime?
  lugarAplicacion       String?

  // Muestra autóloga
  tipoMuestra           String?  // tejido_adiposo, foliculo_piloso, sangre, medula, otro
  fechaExtraccion       DateTime?
  horaExtraccion        String?
  lugarExtraccion       String?
  profesionalExtraccion String?
  metodoTransporte      String?
  temperaturaTransporte String?

  // Entrega
  nombreReceptor        String?
  telefonoReceptor      String?
  institucionEntrega    String?
  direccionEntrega      String?
  ciudadEntrega         String?
  provinciaEntrega      String?
  cpEntrega             String?
  tipoEntrega           String?  // cadena_frio, temperatura_ambiente, retiro_laboratorio
  fechaRequerida        DateTime?
  horarioPreferido      String?

  // Validación interna
  medicoRegistrado      Boolean @default(false)
  medicoValidado        Boolean @default(false)
  samhreVerificado      Boolean @default(false)
  capacitacionVerificada Boolean @default(false)
  clienteAprobado       Boolean @default(false)
  historiaClinicaRecibida Boolean @default(false)
  consentimientoRecibido Boolean @default(false)
  ordenMedicaRecibida    Boolean @default(false)
  documentacionCompleta  Boolean @default(false)

  // Pago
  cotizacionNumero      String?
  montoTotal            Float?
  estadoPago            String?  @default("pendiente") // pendiente, pagado
  fechaPago             DateTime?

  // Control
  validadoPorId         String?
  fechaValidacion       DateTime?
  observaciones         String?
  createdById           String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  medico      Medico    @relation(fields: [medicoId], references: [id])
  paciente    Paciente  @relation(fields: [pacienteId], references: [id])
  createdBy   User      @relation("SolicitudCreator", fields: [createdById], references: [id])
  validadoPor User?     @relation("SolicitudValidator", fields: [validadoPorId], references: [id])
  documentos  SolicitudDocumento[]
  fulfillment Fulfillment?
  evidencia   EvidenciaEntrega?

  @@index([estado])
  @@index([medicoId])
  @@index([createdAt])
}

model SolicitudDocumento {
  id           String   @id @default(cuid())
  solicitudId  String
  tipo         String   // historia_clinica, consentimiento, orden_medica, laboratorio, imagenes, serologias, identidad, otro
  nombre       String
  fileUrl      String
  createdAt    DateTime @default(now())

  solicitud Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
}

// ─── Inventario ─────────────────────────────────────────────────

model Producto {
  id            String   @id @default(cuid())
  sku           String   @unique
  nombre        String
  descripcion   String?
  categoria     String   // exosomas, celulas_madre, fibroblastos, peptidos, foliculo_piloso, lisado_plaquetario, otro
  presentacion  String?
  precioUnitario Float
  costoUnitario  Float
  requiereFrio  Boolean  @default(true)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  inventario    Inventario[]
}

model Inventario {
  id               String    @id @default(cuid())
  productoId       String
  lote             String
  cantidad         Int
  fechaVencimiento DateTime?
  ubicacion        String    @default("Laboratorio Principal")
  tipoAlmacenamiento String  @default("frio") // frio, seco
  umbralMinimo     Int       @default(5)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([productoId, lote])
  @@index([productoId])
  @@index([lote])
}

// ─── Fulfillment ────────────────────────────────────────────────

model Fulfillment {
  id              String    @id @default(cuid())
  solicitudId     String    @unique
  loteAsignado    String?
  productoReservado String?
  cantidad        Int?
  fechaVencimiento DateTime?
  ubicacion       String?
  fechaPreparacion DateTime?
  responsableId   String?
  fechaDespacho   DateTime?
  metodoEnvio     String?   // moto, andreani, transporte_especializado, retiro
  tracking        String?
  temperaturaEnvio String?
  estado          String    @default("pendiente") // pendiente, preparando, listo, despachado, entregado
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  solicitud   Solicitud @relation(fields: [solicitudId], references: [id])
  responsable User?     @relation("FulfillmentResponsable", fields: [responsableId], references: [id])
}

// ─── Evidencia de Entrega ───────────────────────────────────────

model EvidenciaEntrega {
  id              String    @id @default(cuid())
  solicitudId     String    @unique
  nombreReceptor  String?
  dniReceptor     String?
  fechaHoraEntrega DateTime?
  firmaUrl        String?
  fotoUrl         String?
  observaciones   String?
  estado          String    @default("pendiente") // pendiente, confirmada
  creadoPorId     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  solicitud Solicitud @relation(fields: [solicitudId], references: [id])
  creadoPor User      @relation("EvidenciaCreator", fields: [creadoPorId], references: [id])
}

// ─── Pagos ──────────────────────────────────────────────────────

model Pago {
  id            String   @id @default(cuid())
  solicitudNum  String
  monto         Float
  metodo        String   // quickbooks, efectivo, transferencia
  comprobante   String?
  estado        String   @default("pendiente") // pendiente, confirmado
  fechaPago     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Activity & Audit Log ───────────────────────────────────────

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entityType  String   // solicitud, medico, paciente, inventario, fulfillment, evidencia, pago
  entityId    String
  details     String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType])
  @@index([createdAt])
}

// ─── Alertas ────────────────────────────────────────────────────

model Alert {
  id          String   @id @default(cuid())
  type        String   // stock_bajo, solicitud_pendiente, pago_pendiente, documento_faltante, vencimiento
  severity    String   @default("warning") // info, warning, critical
  title       String
  message     String
  entityType  String?
  entityId    String?
  isRead      Boolean  @default(false)
  isDismissed Boolean  @default(false)
  createdAt   DateTime @default(now())
}
