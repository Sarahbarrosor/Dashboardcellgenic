generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Users & Teams ───────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("member") // admin, manager, member
  avatar    String?
  locationId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location       Location?      @relation(fields: [locationId], references: [id])
  assignedTasks  Task[]         @relation("TaskAssignee")
  createdTasks   Task[]         @relation("TaskCreator")
  orders         Order[]        @relation("OrderCreator")
  orderComments  OrderComment[]
  activityLogs   ActivityLog[]
  requestedTransfers  Transfer[]        @relation("TransferRequester")
  approvedTransfers   Transfer[]        @relation("TransferApprover")
  receivedTransfers   Transfer[]        @relation("TransferReceiver")
  transferComments    TransferComment[]
}

// ─── Locations ───────────────────────────────────────────────────

model Location {
  id         String   @id @default(cuid())
  name       String   @unique
  code       String?  @unique // short code e.g. "MWH", "EAS"
  type       String   @default("warehouse") // warehouse, distribution, retail, depot, office
  address    String?
  city       String?
  country    String?  @default("USA")
  managerName  String?
  managerEmail String?
  phone      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users              User[]
  outgoingTransfers  Transfer[] @relation("FromLocation")
  incomingTransfers  Transfer[] @relation("ToLocation")
}

// ─── Products & Inventory ────────────────────────────────────────

model Product {
  id            String   @id @default(cuid())
  sku           String   @unique
  name          String
  description   String?
  category      String
  brand         String   @default("Cellgenic")
  unitPrice     Float
  costPrice     Float
  imageUrl      String?
  katanaId      String?  // External Katana reference
  quickbooksId  String?  // External QuickBooks reference
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  inventory        Inventory[]
  documents        ProductDocument[]
  orderItems       OrderItem[]
  salesRecords     SaleRecord[]
  inventoryHistory InventoryHistory[]
}

model Inventory {
  id               String   @id @default(cuid())
  productId        String
  location         String   @default("Main Warehouse")
  quantity         Int
  minimumThreshold Int      @default(10)
  reorderPoint     Int      @default(20)
  reorderQuantity  Int      @default(50)
  lastRestocked    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, location])
}

model ProductDocument {
  id          String   @id @default(cuid())
  productId   String
  name        String
  type        String   // coa, first_party_test, third_party_test, brochure, catalog, msds, other
  fileUrl     String
  fileSize    Int?
  uploadedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─── Sales Tracking ──────────────────────────────────────────────

model SaleRecord {
  id          String   @id @default(cuid())
  productId   String
  quantity    Int
  unitPrice   Float
  totalAmount Float
  channel     String   @default("direct") // direct, online, wholesale, distributor
  customerName String?
  saleDate    DateTime @default(now())
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─── Orders ──────────────────────────────────────────────────────

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  type            String   @default("sales") // sales, purchase, internal
  status          String   @default("pending") // pending, confirmed, processing, shipped, delivered, cancelled
  customerName    String?
  customerEmail   String?
  supplierName    String?
  totalAmount     Float    @default(0)
  notes           String?
  createdById     String
  katanaOrderId   String?
  quickbooksInvoiceId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy  User          @relation("OrderCreator", fields: [createdById], references: [id])
  items      OrderItem[]
  comments   OrderComment[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Float
  total     Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model OrderComment {
  id        String   @id @default(cuid())
  orderId   String
  userId    String
  content   String
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])
}

// ─── Tasks & Workflows ──────────────────────────────────────────

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("todo") // todo, in_progress, review, done
  priority    String    @default("medium") // low, medium, high, urgent
  category    String    @default("general") // general, inventory, orders, shipping, quality, admin
  dueDate     DateTime?
  completedAt DateTime?
  assigneeId  String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignee  User? @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy User  @relation("TaskCreator", fields: [createdById], references: [id])
}

// ─── Activity & Audit Log ────────────────────────────────────────

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String   // created, updated, deleted, status_changed, commented, etc.
  entityType  String   // order, task, product, inventory
  entityId    String
  details     String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

// ─── Integration Settings ────────────────────────────────────────

model IntegrationConfig {
  id          String   @id @default(cuid())
  provider    String   @unique // katana, quickbooks
  apiKey      String?
  apiSecret   String?
  baseUrl     String?
  isActive    Boolean  @default(false)
  lastSyncAt  DateTime?
  settings    String?  // JSON string for additional settings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Transfers Between Locations ────────────────────────────────

model Transfer {
  id               String    @id @default(cuid())
  transferNumber   String    @unique
  fromLocationId   String
  toLocationId     String
  status           String    @default("requested")
  // requested → pending approval at source location
  // approved → source approved, preparing to ship
  // in_transit → shipped, on the way
  // received → delivered and confirmed at destination
  // rejected → rejected by source location
  // cancelled → cancelled by requester
  priority         String    @default("normal") // low, normal, high, urgent
  reason           String?   // why the transfer is needed
  notes            String?
  trackingNumber   String?
  shippingMethod   String?   // courier, internal_fleet, pickup
  estimatedArrival DateTime?
  requestedById    String
  approvedById     String?
  receivedById     String?
  requestedAt      DateTime  @default(now())
  approvedAt       DateTime?
  shippedAt        DateTime?
  receivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  fromLocation Location          @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocation   Location          @relation("ToLocation", fields: [toLocationId], references: [id])
  requestedBy  User              @relation("TransferRequester", fields: [requestedById], references: [id])
  approvedBy   User?             @relation("TransferApprover", fields: [approvedById], references: [id])
  receivedBy   User?             @relation("TransferReceiver", fields: [receivedById], references: [id])
  items        TransferItem[]
  comments     TransferComment[]
}

model TransferItem {
  id                String @id @default(cuid())
  transferId        String
  productId         String
  quantityRequested Int
  quantityShipped   Int?
  quantityReceived  Int?
  unitCost          Float?
  notes             String?

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
}

model TransferComment {
  id         String   @id @default(cuid())
  transferId String
  userId     String
  content    String
  createdAt  DateTime @default(now())

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])
}

// ─── Inventory History (Change Tracking) ────────────────────────

model InventoryHistory {
  id          String   @id @default(cuid())
  productId   String
  location    String
  previousQty Int
  newQty      Int
  changeQty   Int
  changeType  String   // sync, manual, transfer, sale
  source      String   // katana, manual, transfer_in, transfer_out, system
  syncId      String?
  notes       String?
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([location])
  @@index([createdAt])
  @@index([syncId])
}

model SyncLog {
  id          String   @id @default(cuid())
  scope       String   // all, locations, products, inventory, sales_orders
  status      String   // running, completed, failed
  trigger     String   // cron, manual, webhook
  productsCreated   Int @default(0)
  productsUpdated   Int @default(0)
  inventorySynced   Int @default(0)
  inventoryChanged  Int @default(0)
  locationsCreated  Int @default(0)
  locationsUpdated  Int @default(0)
  ordersCreated     Int @default(0)
  ordersUpdated     Int @default(0)
  errorMessage String?
  startedAt   DateTime @default(now())
  completedAt DateTime?

  @@index([startedAt])
}

// ─── Alerts ──────────────────────────────────────────────────────

model Alert {
  id          String   @id @default(cuid())
  type        String   // low_stock, reorder, overdue_task, order_status, system
  severity    String   @default("warning") // info, warning, critical
  title       String
  message     String
  entityType  String?
  entityId    String?
  isRead      Boolean  @default(false)
  isDismissed Boolean  @default(false)
  createdAt   DateTime @default(now())
}
