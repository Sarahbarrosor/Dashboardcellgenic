{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "functions": {
    "src/app/api/katana/sync/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/katana/cron/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/setup/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/katana/cron",
      "schedule": "*/5 * * * *"
    }
  ]
}
