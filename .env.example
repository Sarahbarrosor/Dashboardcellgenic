# ─── Database ────────────────────────────────────────────────────
# Postgres connection string. On Vercel, use Vercel Postgres / Neon / Supabase.
# Pooled connection used by runtime queries.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Direct (non-pooled) connection used by migrations & `prisma db push`.
# For Vercel Postgres, this is POSTGRES_URL_NON_POOLING.
DIRECT_URL="postgresql://user:password@host:5432/database?sslmode=require"

# ─── Katana MRP Integration ─────────────────────────────────────
# Your Katana API key (Bearer token). Get from Katana dashboard → Settings → API.
KATANA_API_KEY=""

# Optional: override base URL (default: https://api.katanamrp.com/v1)
# KATANA_BASE_URL="https://api.katanamrp.com/v1"

# ─── QuickBooks Integration (optional) ──────────────────────────
# QUICKBOOKS_API_KEY=""
# QUICKBOOKS_CLIENT_ID=""
# QUICKBOOKS_CLIENT_SECRET=""
